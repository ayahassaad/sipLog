# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@siplog.bjyvxki.mongodb.net/siplog?appName=sipLog

# Port the API listens on
PORT=5001

# URL of the deployed (or local) frontend, for CORS. Must be an exact match,
# no trailing slash.
CLIENT_ORIGIN=http://localhost:5173

# Set to "production" when deployed - controls cookie Secure/SameSite flags.
NODE_ENV=development

# Long random string used to sign auth JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Only needed if the frontend and backend are on different subdomains of the
# same parent domain (e.g. api.siplog.app / app.siplog.app -> ".siplog.app").
# Leave unset for cross-origin setups like vercel.app + onrender.com.
COOKIE_DOMAIN=

# Cloudinary (image storage) - from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
